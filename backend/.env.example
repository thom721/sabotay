PROJECT_NAME=SabotayPro
ENVIRONMENT=development

# Async URL used by the app (psycopg 3, async mode)
DATABASE_URL=postgresql+psycopg://sabotay:sabotay@localhost:5432/sabotaypro

# Sync URL used by Alembic (psycopg 3, sync mode)
DATABASE_URL_SYNC=postgresql+psycopg://sabotay:sabotay@localhost:5432/sabotaypro

SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SMTP (email) — laisser vide en dev, fallback console automatique
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Twilio (SMS) — laisser vide en dev, fallback console automatique
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

# MonCash (paiement mobile Digicel Haïti) — laisser vide en dev, fallback 503
# automatique sur /abonnement/payer tant que non configuré
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
MONCASH_MODE=sandbox
ABONNEMENT_MONTANT_HTG=100

# Clé privée Ed25519 pour GET /abonnement/licence — laisser vide en dev,
# fallback 503 automatique. Générer via scripts/generate_licence_keypair.py
# (ne jamais commiter la vraie valeur). Ne JAMAIS régler sur une
# installation locale (LOCAL_MODE=true) — cloud uniquement.
LICENCE_PRIVATE_KEY=

# Mode local (Phase 2a) — laisser à false pour le cloud multi-tenant
# (comportement par défaut, inchangé). true = serveur mono-tenant SQLite
# qui se synchronise avec le cloud plutôt que de servir de source de
# vérité (voir app/api/v1/endpoints/sync.py).
LOCAL_MODE=false
LOCAL_DATABASE_PATH=./sabotay_local.db
CLOUD_SYNC_URL=
CLOUD_SYNC_TOKEN=
DEVICE_ID=self
