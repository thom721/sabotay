server {
    if ($host = sabotay.infini-software.cloud) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    listen [::]:80;
    server_name sabotay.infini-software.cloud;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
}

server {
    server_name sabotay.infini-software.cloud;

    listen [::]:443 ssl;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/sabotay.infini-software.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sabotay.infini-software.cloud/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location /static/ {
        alias /var/www/sabotay.infini-software.cloud/static/;
        expires 30d;
    }

    location /ws {
        proxy_pass         http://127.0.0.1:9008/ws;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host $host;
        proxy_read_timeout 3600s;
    }

    location /api/ {
        proxy_pass         http://127.0.0.1:9008/api/;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location /health {
        proxy_pass http://127.0.0.1:9008/health;
        proxy_set_header Host $host;
    }

    location / {
        root /var/www/sabotay.infini-software.cloud;
        try_files $uri $uri/ /index.html;
    }
}