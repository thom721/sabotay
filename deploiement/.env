# ⚠️  Valeurs d'exemple — à remplacer avant tout déploiement réel.
# Ne jamais commiter ce fichier une fois rempli avec de vraies valeurs
# (secrets de production) — voir la note à ce sujet dans le message qui
# accompagne la création de ce fichier.

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_DB=sabotaypro
POSTGRES_USER=sabotay
POSTGRES_PASSWORD=change-me

# ── Backend — sécurité JWT (OBLIGATOIRE) ────────────────────────────────────
# Générer : openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret

# ── CORS — domaine(s) exact(s), jamais "*" en production ───────────────────
CORS_ORIGINS=https://sabotay.infini-software.cloud

# ── SMTP (email) — laisser vide pour désactiver, fallback log automatique ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ── Twilio (SMS) — laisser vide pour désactiver, fallback log automatique ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── MonCash (paiement mobile Digicel Haïti) ─────────────────────────────────
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
MONCASH_MODE=live
ABONNEMENT_MONTANT_HTG=100

# ── Licence Ed25519 (cloud uniquement — jamais sur un poste local) ─────────
# Générer : python ../backend/scripts/generate_licence_keypair.py — la clé
# PUBLIQUE générée doit être reportée dans web/mobile (licence_verifier.dart)
# ET dans backend/app/core/licence.py::LICENCE_PUBLIC_KEY_B64 (3 endroits,
# doivent toujours matcher). Ne JAMAIS commiter la clé PRIVÉE ci-dessous.
LICENCE_PRIVATE_KEY=
